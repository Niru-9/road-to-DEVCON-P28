# Copy to `.env` (git-ignored) and fill in locally. Never commit `.env`.
#
# Sepolia JSON-RPC endpoint. A plain public endpoint is fine, e.g.
#   https://rpc.sepolia.org
# Do NOT paste an authenticated URL that contains an API key into a tracked file.
SEPOLIA_RPC_URL=

# Address that receives the funds when the campaign succeeds (Meera's wallet).
CAMPAIGN_BENEFICIARY=

# Funding target in ETH (the deploy script converts to wei).
CAMPAIGN_TARGET_ETH=1

# Campaign duration in whole days, counted from the deployment timestamp.
CAMPAIGN_DURATION_DAYS=14

# Only needed for the Foundry deploy script. Remix/MetaMask users can ignore this.
# Use a throwaway test key. Never commit it.
PRIVATE_KEY=

# Optional: lets `forge verify-contract` publish the source on Etherscan.
ETHERSCAN_API_KEY=
